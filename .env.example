# ==========================================
# UNI:VERSE Environment Variables Example
# ==========================================

# ------------------------------------------
# Backend
# ------------------------------------------
# Database Connection (RDS MySQL or Local)
DB_URL=jdbc:mysql://localhost:3306/universe?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=universe
DB_PASSWORD=universe-dev

# Security
JWT_SECRET_KEY=local-development-only-change-this-secret-key

# AI Server Integration
# Service Discovery URI in ECS, e.g. http://ai-server.universe.local:8000
# or localhost for local development
AI_SERVER_BASE_URL=http://localhost:8000

# Email Sending Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# AWS S3 Integration (For Image Uploads)
# Note: AWS credentials are automatically resolved in ECS via Task Role
S3_ENABLED=true
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=universe-images-your-bucket-id

# ------------------------------------------
# Frontend
# ------------------------------------------
# API endpoint base URL.
# In production, ALB routing will forward /api to backend, so relative path is fine.
# In local development, leave this empty to use Vite proxy, or set to http://localhost:8080/api/v1
VITE_API_BASE_URL=/api/v1

# ------------------------------------------
# AI Server
# ------------------------------------------
# AI Server does not currently require external environment variables.
# Models and rules are managed internally.
