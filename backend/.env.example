# Database Settings
DB_URL=jdbc:mysql://localhost:3306/universe
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here

# JWT Settings
JWT_SECRET_KEY=put_your_very_long_secret_key_here

# AI Server (FastAPI) Settings
AI_SERVER_URL=http://localhost:8000

# School verification mail (SMTP)
# Example for Gmail: smtp.gmail.com + an app password, not the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=your_email@gmail.com
